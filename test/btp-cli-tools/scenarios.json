{
    "btp_cli_tools_default": {
        "image": "mcr.microsoft.com/devcontainers/base:debian",
        "features": {
            "btp-cli-tools": {
                "version": "8"
            }
        }
    },
    "btp_cli_tools_skip_cf_on_failure": {
        "image": "mcr.microsoft.com/devcontainers/base:debian",
        "features": {
            "btp-cli-tools": {
                "version": "does-not-exist",
                "skip-cf-on-failure": true,
                "plugins": "multiapps"
            }
        }
    },
    "btp_cli_tools_with_plugins": {
        "image": "mcr.microsoft.com/devcontainers/base:debian",
        "features": {
            "btp-cli-tools": {
                "version": "8",
                "plugins": "multiapps"
            }
        }
    }
}